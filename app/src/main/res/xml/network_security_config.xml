<?xml version="1.0" encoding="utf-8"?>
<!--
  Hermes Agent Network Security Configuration.

  Security model:
  - Cleartext traffic is allowed only to localhost for the embedded
    Python gateway (WebSocket on 127.0.0.1:8320).
  - All remote connections require TLS.
  - User certificates are trusted (for enterprise CA deployments).
  - No debug-override domains.
-->
<network-security-config>
    <!-- Local Python gateway -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Trust user-installed CAs for enterprise environments -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
